# =============================================================================
# SIU_Pumpking - CLIENT .env
# =============================================================================
# LOCAL on this machine : hub_service (9021) + nginx (9027, serves YOUR frames)
# REMOTE on the server  : SIGLIP_v2 (9029), util (9025), qdrant (6333/6334)
#
# Only the two *_HOST_PUBLIC lines below cross the tunnel. Frames and videos
# never leave this machine.
#
# EDIT: (1) DATA_ROOT paths in nginx/conf/nginx.conf, (2) nothing else if you
# use `ssh -L`. With ngrok, replace the two *_HOST_PUBLIC values.
# =============================================================================

#BASIC STUFFS
REQUEST_TIMEOUT = 60
ENABLE_GZIP = True
BASE_URL = "http://localhost:9021"

# --- REMOTE (server, through the tunnel) -------------------------------------
# ssh -L  -> keep as localhost.  ngrok -> "https://<reserved-domain>"
SIGLIP_V2_HOST_PUBLIC = "http://localhost:9029"
UTIL_HOST_PUBLIC = "http://localhost:9025"

# --- FRAMES: local nginx (your own `0/frames/...` copy) ----------------------
# The hub 307-redirects here, so the BROWSER fetches this. Local = fast, and no
# image bytes cross the tunnel.
NGINX_IMAGE_HOST = "http://localhost:9027/img"
NGINX_IMG_PORT = 9027

# --- VIDEO: the SERVER's nginx, through the tunnel ---------------------------
# You only have `0/`, which has no `original/` folder, so videos cannot be
# served locally. This is ALSO fetched by the browser, so it must be
# browser-reachable - not just reachable from the hub process.
#   ssh -L 9028:localhost:9027 -> "http://localhost:9028/video"
#   ngrok (reserved domain)    -> "https://siupumpking.nginxdomain.ngrok.app/video"
# If you DO have the videos locally, uncomment the /video/ block in
# nginx/conf/nginx.conf and set this to "http://localhost:9027/video".
NGINX_VIDEO_HOST = "http://localhost:9028/video"
NGINX_VIDEO_PORT = 9028

# Leave unset. The hub only self-serves frames if you skip nginx entirely
# (see README_LOCAL.md "No-nginx fallback").
# IMAGE_LOCAL_PATH = "/your/path/to/data/aic_2025"

# --- DATASET PATH STRINGS ----------------------------------------------------
# NOT read from disk by the hub - used only as string prefixes that cancel out
# via os.path.relpath. Your real dataset location is configured in
# nginx/conf/nginx.conf (the `alias` lines), NOT here. Leave these as-is.
BASE_PATH = '/mnt/e/random42/data/aic_2025'
DATASET_PATH_ORIGIN = '/mnt/e/random42/data/aic_2025/original'
DATASET_PATH_TEAM = '/mnt/e/random42/data/aic_2025'
KEYFRAME_FOLDER_PATH = "/mnt/e/random42/data/aic_2025"
DATASET_INDEX = "/mnt/e/random42/data/aic_2025/index"
SPLIT_NAME = "low_res_autoshot"
SPLIT_NAME_LOW_RES = "low_res_autoshot"
LOWRES_FORMAT = ".avif"

# Read by the util/SIGLIP services on the server, never by the hub. These may
# point at files you do not have - verified: the hub starts and every endpoint
# works with all of them dangling. Do not download these JSONs.
S2T_PATH = ["/mnt/e/random42/data/aic_2025/0/speech_to_text2/transcript_all_autoshot_segmented.json", "/mnt/e/random42/data/aic_2025/1/speech_to_text/transcript_all_autoshot_segmented.json"]
OBJECT_PATH = "/mnt/e/random42/data/aic_2025/utils/object/total_0_1.json"
FPS_PATH = ['/mnt/e/random42/data/aic_2025/0/fps/video_fps_0.json', '/mnt/e/random42/data/aic_2025/1/fps/video_fps_1.json']
SHOT_PATH = ['/mnt/e/random42/data/aic_2025/0/shot/shot_0.json', '/mnt/e/random42/data/aic_2025/1/shot/shot_1.json']

# --- HUB (this machine) ------------------------------------------------------
HUB_HOST = 0.0.0.0
HUB_PORT = 9021
HUB_MAX_WORKERS = 4

# --- OPTIONAL SERVICES (server does not run these) ---------------------------
ENABLE_SUBMISSION = false
ENABLE_SIGLIP_BETA = false
ENABLE_RERANK = false

SIGLIP_V2_B_HOST_PUBLIC = "http://localhost:9030"
RERANK_HOST_PUBLIC = "http://localhost:9026"
SUBMISSION_HOST_PUBLIC = "http://localhost:9024"
